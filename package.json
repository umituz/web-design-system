{
  "name": "@umituz/web-design-system",
  "version": "4.34.0",
  "private": false,
  "type": "module",
  "description": "Web Design System - Tailwind v4 authored, precompiled CSS shipped. Atomic Design components (Atoms, Molecules, Organisms, Templates) for React applications.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./app.css": "./src/styles/app.css",
    "./atoms": "./src/presentation/atoms/index.ts",
    "./bridge.css": "./src/styles/bridge.css",
    "./constants": "./src/infrastructure/constants/index.ts",
    "./hooks": "./src/presentation/hooks/index.ts",
    "./molecules": "./src/presentation/molecules/index.ts",
    "./organisms": "./src/presentation/organisms/index.ts",
    "./package.json": "./package.json",
    "./source.css": "./src/styles/source.css",
    "./styles.css": "./dist/styles.css",
    "./templates": "./src/presentation/templates/index.ts",
    "./theme.css": "./src/styles/theme.css",
    "./tokens": "./src/domain/tokens/index.ts",
    "./types": "./src/domain/types/index.ts",
    "./utils": "./src/infrastructure/utils/index.ts",
    "./utils/cn": "./src/infrastructure/utils/cn.util.ts"
  },
  "scripts": {
    "build": "tailwindcss -i src/styles/compile.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && vitest run",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "keywords": [
    "web",
    "design-system",
    "react",
    "atomic-design",
    "ui-components",
    "atoms",
    "molecules",
    "organisms",
    "tailwind",
    "tailwindcss",
    "precompiled-css"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-design-system.git"
  },
  "dependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@radix-ui/react-accordion": ">=1.0.0",
    "@radix-ui/react-collapsible": ">=1.0.0",
    "@radix-ui/react-dialog": ">=1.0.0",
    "@radix-ui/react-dropdown-menu": ">=1.0.0",
    "@radix-ui/react-hover-card": ">=1.0.0",
    "@radix-ui/react-label": ">=2.0.0",
    "@radix-ui/react-popover": ">=1.0.0",
    "@radix-ui/react-scroll-area": ">=1.0.0",
    "@radix-ui/react-select": ">=2.0.0",
    "@radix-ui/react-separator": ">=1.0.0",
    "@radix-ui/react-slot": ">=1.0.0",
    "@radix-ui/react-switch": ">=1.0.0",
    "@radix-ui/react-toggle": ">=1.0.0",
    "@radix-ui/react-toggle-group": ">=1.0.0",
    "lucide-react": ">=0.400.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router": ">=6.0.0",
    "react-syntax-highlighter": ">=15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.8",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@tailwindcss/cli": "^4.1.17",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ]
}
